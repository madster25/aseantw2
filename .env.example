# Optional. HTTPS endpoint that accepts a JSON POST from the membership enquiry form
# (fields: name, company, email, market, interest, message, lang, submittedAt).
# When unset, the form explains that online submission is not configured and offers
# a copyable enquiry instead. It never reports a false success.
VITE_ENQUIRY_ENDPOINT=""

# Set to "true" to include the layout samples from src/data/events.sample.ts (development only).
# VITE_SHOW_SAMPLE_EVENTS=true
